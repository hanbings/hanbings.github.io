---
import IndexLayout from '../layouts/IndexLayout.astro'
import EntryList from '../components/index/EntryList.astro'
import {getCollection} from 'astro:content'

const [markdownPosts, typstPosts] = await Promise.all([
    getCollection('posts'),
    getCollection('typstPosts'),
])
const posts = [
    ...markdownPosts.map((post) => ({
        id: post.id,
        title: post.data.title,
        date: post.data.date,
        tags: post.data.tags,
        draft: Boolean(post.data.draft),
    })),
    ...typstPosts.map((post) => ({
        id: post.id,
        title: post.data.title,
        date: post.data.date,
        tags: post.data.tags,
        draft: Boolean(post.data.draft),
    })),
].sort(
    (a, b) =>
        new Date(b.date.replace(' ', 'T')).getTime() - new Date(a.date.replace(' ', 'T')).getTime(),
)
const publishedPosts = posts.filter(({draft}) => !draft)
const draftPosts = posts.filter(({draft}) => draft)
---

<IndexLayout title="文章">
    <h1 class="text-2xl font-bold">文章</h1>
    <EntryList
        class="mt-6"
        heading="发布的文章"
        headingId="published-posts-title"
        items={publishedPosts.map((post) => ({
            title: post.title,
            href: `/posts/${post.id}/`,
            date: post.date,
            tags: post.tags,
        }))}
    />
    {
        draftPosts.length > 0 && (
            <EntryList
                class="mt-6"
                heading="草稿文章"
                headingId="draft-posts-title"
                items={draftPosts.map((post) => ({
                    title: post.title,
                    href: `/posts/${post.id}/`,
                    date: post.date,
                    tags: post.tags,
                }))}
            />
        )
    }
</IndexLayout>
