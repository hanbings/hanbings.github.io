---
import IndexLayout from '../layouts/IndexLayout.astro'
import EntryList from '../components/index/EntryList.astro'
import Content from '../content/specs/home.md'
import {getCollection} from 'astro:content'
import '../styles/markdown/github.css'

const [markdownPosts, typstPosts] = await Promise.all([
    getCollection('posts'),
    getCollection('typstPosts'),
])
const allPosts = [
    ...markdownPosts.map((post) => ({
        id: post.id,
        title: post.data.title,
        date: post.data.date,
        tags: post.data.tags,
        draft: Boolean(post.data.draft),
    })),
    ...typstPosts.map((post) => ({
        id: post.id,
        title: post.data.title,
        date: post.data.date,
        tags: post.data.tags,
        draft: Boolean(post.data.draft),
    })),
]
    .filter(({draft}) => !draft)
    .sort(
        (a, b) =>
            new Date(b.date.replace(' ', 'T')).getTime() -
            new Date(a.date.replace(' ', 'T')).getTime(),
    )
---

<IndexLayout title="主页">
    <div class="markdown-body">
        <Content />
    </div>
    <EntryList
        class="mt-6"
        heading="近期文章"
        headingId="recent-posts-title"
        items={allPosts.map((post) => ({
            title: post.title,
            href: `/posts/${post.id}/`,
            date: post.date,
            tags: post.tags,
        }))}
    />
</IndexLayout>
