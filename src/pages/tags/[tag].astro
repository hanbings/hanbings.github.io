---
import {getCollection} from 'astro:content'
import IndexLayout from '../../layouts/IndexLayout.astro'
import EntryList from '../../components/index/EntryList.astro'

export async function getStaticPaths() {
    const allPosts = await getCollection('posts')

    const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))]

    return allTags.map((tag) => {
        const filteredPosts = allPosts.filter((post) => post.data.tags.includes(tag))
        return {
            params: {tag},
            props: {posts: filteredPosts},
        }
    })
}

const {tag} = Astro.params
const {posts} = Astro.props
const sortedPosts = [...posts].sort(
    (a, b) =>
        new Date(b.data.date.replace(' ', 'T')).getTime() -
        new Date(a.data.date.replace(' ', 'T')).getTime(),
)
const publishedPosts = sortedPosts.filter(({data}) => !data.draft)
const draftPosts = sortedPosts.filter(({data}) => data.draft)
---

<IndexLayout title={tag}>
    <h1 class="text-2xl font-bold">{`#${tag}`}</h1>
    {
        publishedPosts.length > 0 && (
            <EntryList
                class="mt-6"
                heading="发布的文章"
                headingId="published-posts-title"
                items={publishedPosts.map((post) => ({
                    title: post.data.title,
                    href: `/posts/${post.id}/`,
                    date: post.data.date,
                    tags: post.data.tags,
                }))}
            />
        )
    }
    {
        draftPosts.length > 0 && (
            <EntryList
                class="mt-6"
                heading="草稿文章"
                headingId="draft-posts-title"
                items={draftPosts.map((post) => ({
                    title: post.data.title,
                    href: `/posts/${post.id}/`,
                    date: post.data.date,
                    tags: post.data.tags,
                }))}
            />
        )
    }
</IndexLayout>
