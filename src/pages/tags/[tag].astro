---
import {getCollection} from 'astro:content'
import IndexLayout from '../../layouts/IndexLayout.astro'
import EntryList from '../../components/index/EntryList.astro'
import {compareDatesDescending, getPostDate} from '../../utils/date'

export async function getStaticPaths() {
    const [markdownPosts, typstPosts] = await Promise.all([
        getCollection('posts'),
        getCollection('typstPosts'),
    ])
    const allPosts = [
        ...markdownPosts.map((post) => ({
            id: post.id,
            title: post.data.title,
            date: getPostDate(post.data),
            tags: post.data.tags,
            draft: Boolean(post.data.draft),
        })),
        ...typstPosts.map((post) => ({
            id: post.id,
            title: post.data.title,
            date: getPostDate(post.data),
            tags: post.data.tags,
            draft: Boolean(post.data.draft),
        })),
    ]

    const allTags = [...new Set(allPosts.flatMap((post) => post.tags))]

    return allTags.map((tag) => {
        const filteredPosts = allPosts.filter((post) => post.tags.includes(tag))
        return {
            params: {tag},
            props: {posts: filteredPosts},
        }
    })
}

const {tag} = Astro.params
const {posts} = Astro.props
const sortedPosts = [...posts].sort((a, b) => compareDatesDescending(a.date, b.date))
const publishedPosts = sortedPosts.filter(({draft}) => !draft)
const draftPosts = sortedPosts.filter(({draft}) => draft)
---

<IndexLayout title={tag}>
    <h1 class="text-2xl font-bold">{`#${tag}`}</h1>
    {
        publishedPosts.length > 0 && (
            <EntryList
                class="mt-6"
                heading="发布的文章"
                headingId="published-posts-title"
                items={publishedPosts.map((post) => ({
                    title: post.title,
                    href: `/posts/${post.id}/`,
                    date: post.date,
                    tags: post.tags,
                }))}
            />
        )
    }
    {
        draftPosts.length > 0 && (
            <EntryList
                class="mt-6"
                heading="草稿文章"
                headingId="draft-posts-title"
                items={draftPosts.map((post) => ({
                    title: post.title,
                    href: `/posts/${post.id}/`,
                    date: post.date,
                    tags: post.tags,
                }))}
            />
        )
    }
</IndexLayout>
