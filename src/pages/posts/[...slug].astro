---
import {getCollection, type CollectionEntry} from 'astro:content'
import MarkdownPost from '../../components/post/MarkdownPost.astro'
import TypstPost from '../../components/post/TypstPost.astro'

export async function getStaticPaths() {
    const [markdownPosts, typstPosts] = await Promise.all([
        getCollection('posts'),
        getCollection('typstPosts'),
    ])
    const markdownIds = new Set(markdownPosts.map(({id}) => id))
    const duplicate = typstPosts.find(({id}) => markdownIds.has(id))
    if (duplicate) {
        throw new Error(`Markdown 和 Typst post 使用了相同的 slug：${duplicate.id}`)
    }

    return [
        ...markdownPosts.map((entry) => ({
            params: {slug: entry.id},
            props: {format: 'markdown' as const, entry},
        })),
        ...typstPosts.map((entry) => ({
            params: {slug: entry.id},
            props: {format: 'typst' as const, entry},
        })),
    ]
}

type Props =
    | {format: 'markdown'; entry: CollectionEntry<'posts'>}
    | {format: 'typst'; entry: CollectionEntry<'typstPosts'>}

const props = Astro.props as Props
---

{
    props.format === 'typst' ? (
        <TypstPost entry={props.entry} />
    ) : (
        <MarkdownPost entry={props.entry} />
    )
}
