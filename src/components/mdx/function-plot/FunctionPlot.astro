---
import {createFunctionPlotModel, type FunctionPlotSeriesInput} from './function-plot'

interface Props {
    title?: string
    expression?: string
    functions?: string | string[] | FunctionPlotSeriesInput[]
    xDomain?: [number, number]
    yDomain?: [number, number]
    height?: number
    class?: string
}

const {title, expression, functions, xDomain, yDomain, height, class: className} = Astro.props
const model = createFunctionPlotModel({
    title,
    expression,
    functions,
    xDomain,
    yDomain,
    height,
})
const serializedSeries = JSON.stringify(model.series)
const serializedXDomain = JSON.stringify(model.xDomain)
const serializedYDomain = JSON.stringify(model.yDomain)
const description = `${model.title}，横轴范围 ${model.xDomain[0]} 到 ${model.xDomain[1]}，纵轴范围 ${model.yDomain[0]} 到 ${model.yDomain[1]}，绘制 ${model.series.map(({label}) => label).join('、')}。可拖动平移；点击图像后可使用滚轮缩放。`
---

<mdx-function-plot
    data-series={serializedSeries}
    data-x-domain={serializedXDomain}
    data-y-domain={serializedYDomain}
    data-wheel-active="false"
>
    <figure
        class:list={['function-plot-window', className]}
        style={`--function-plot-height: ${model.height}px`}
    >
        <figcaption class="function-plot-caption">
            <span class="function-plot-heading">
                <span class="function-plot-title">{model.title}</span>
                <span class="function-plot-hint" data-function-plot-hint aria-live="polite"
                    >点击图像后可用滚轮缩放</span
                >
            </span>
            <button type="button" class="function-plot-reset" data-function-plot-reset>
                重置视图
            </button>
        </figcaption>
        <div class="function-plot-stage">
            <canvas
                class="function-plot-canvas"
                data-function-plot-canvas
                role="img"
                aria-label={description}
                tabindex="0"
            >
                {description}
            </canvas>
            <output class="function-plot-coordinates" data-function-plot-coordinates>
                x = — · y = —
            </output>
            <p class="function-plot-error" data-function-plot-error hidden></p>
        </div>
        <div class="function-plot-legend" aria-label="函数图例">
            {
                model.series.map(({label}, index) => (
                    <span class="function-plot-legend-item">
                        <span
                            class="function-plot-legend-line"
                            style={`--function-plot-series-color: var(--function-plot-series-${index + 1})`}
                            aria-hidden="true"
                        />
                        <span>{label}</span>
                    </span>
                ))
            }
        </div>
        <noscript>
            <p class="function-plot-noscript">启用 JavaScript 后可查看并操作函数图像。</p>
        </noscript>
    </figure>
</mdx-function-plot>

<script>
    import {compileFunctionExpression, type FunctionPlotSeries} from './function-plot'

    interface PlotView {
        xMin: number
        xMax: number
        yMin: number
        yMax: number
    }

    interface PlotMetrics {
        width: number
        height: number
        left: number
        right: number
        top: number
        bottom: number
        plotWidth: number
        plotHeight: number
    }

    const lineDashes = [[], [8, 4], [2, 3], [10, 3, 2, 3], [5, 2], [1, 3]]

    const parseDomain = (value: string | undefined): [number, number] => {
        const parsed: unknown = JSON.parse(value || '[]')
        if (
            !Array.isArray(parsed) ||
            parsed.length !== 2 ||
            !parsed.every((item) => typeof item === 'number' && Number.isFinite(item))
        ) {
            throw new Error('坐标范围无效')
        }
        return [parsed[0], parsed[1]]
    }

    const niceStep = (span: number, targetLines = 8) => {
        const roughStep = span / targetLines
        const power = Math.pow(10, Math.floor(Math.log10(roughStep)))
        const normalized = roughStep / power
        const factor = normalized <= 1 ? 1 : normalized <= 2 ? 2 : normalized <= 5 ? 5 : 10
        return factor * power
    }

    const formatTick = (value: number, step: number) => {
        const absoluteValue = Math.abs(value)
        if ((absoluteValue > 0 && absoluteValue < 0.0001) || absoluteValue >= 100000) {
            return value.toExponential(1)
        }
        const digits = Math.min(6, Math.max(0, -Math.floor(Math.log10(step)) + 1))
        const rounded = Number(value.toFixed(digits))
        return Object.is(rounded, -0) ? '0' : String(rounded)
    }

    const clampSpan = (span: number) => Math.min(1e7, Math.max(1e-6, span))

    class MdxFunctionPlot extends HTMLElement {
        private canvas?: HTMLCanvasElement
        private context?: CanvasRenderingContext2D
        private coordinates?: HTMLOutputElement
        private reset?: HTMLButtonElement
        private error?: HTMLElement
        private hint?: HTMLElement
        private series: Array<FunctionPlotSeries & {evaluate: (x: number) => number}> = []
        private initialView?: PlotView
        private view?: PlotView
        private resizeObserver?: ResizeObserver
        private abortController?: AbortController
        private colorScheme?: MediaQueryList
        private activePointer?: number
        private dragStart?: {clientX: number; clientY: number; view: PlotView}
        private wheelActive = false

        connectedCallback() {
            if (this.abortController) return

            this.canvas =
                this.querySelector<HTMLCanvasElement>('[data-function-plot-canvas]') ?? undefined
            this.context = this.canvas?.getContext('2d') ?? undefined
            this.coordinates =
                this.querySelector<HTMLOutputElement>('[data-function-plot-coordinates]') ??
                undefined
            this.reset =
                this.querySelector<HTMLButtonElement>('[data-function-plot-reset]') ?? undefined
            this.error = this.querySelector<HTMLElement>('[data-function-plot-error]') ?? undefined
            this.hint = this.querySelector<HTMLElement>('[data-function-plot-hint]') ?? undefined
            if (!this.canvas || !this.context || !this.reset) return

            try {
                const parsedSeries: unknown = JSON.parse(this.dataset.series || '[]')
                if (!Array.isArray(parsedSeries) || parsedSeries.length === 0) {
                    throw new Error('没有可绘制的函数')
                }
                this.series = parsedSeries.map((item) => {
                    if (
                        typeof item !== 'object' ||
                        item === null ||
                        !('expression' in item) ||
                        !('label' in item) ||
                        typeof item.expression !== 'string' ||
                        typeof item.label !== 'string'
                    ) {
                        throw new Error('函数数据无效')
                    }
                    return {...item, evaluate: compileFunctionExpression(item.expression)}
                })

                const [xMin, xMax] = parseDomain(this.dataset.xDomain)
                const [yMin, yMax] = parseDomain(this.dataset.yDomain)
                this.initialView = {xMin, xMax, yMin, yMax}
                this.view = {...this.initialView}
            } catch (error) {
                this.showError(error)
                return
            }

            const controller = new AbortController()
            const listenerOptions = {signal: controller.signal}
            this.canvas.addEventListener('pointerdown', this.handlePointerDown, listenerOptions)
            this.canvas.addEventListener('pointermove', this.handlePointerMove, listenerOptions)
            this.canvas.addEventListener('pointerup', this.handlePointerUp, listenerOptions)
            this.canvas.addEventListener('pointercancel', this.handlePointerUp, listenerOptions)
            this.canvas.addEventListener('pointerleave', this.handlePointerLeave, listenerOptions)
            this.canvas.addEventListener('dblclick', this.handleReset, listenerOptions)
            this.canvas.addEventListener('focus', this.handleCanvasFocus, listenerOptions)
            this.canvas.addEventListener('blur', this.handleCanvasBlur, listenerOptions)
            this.canvas.addEventListener('keydown', this.handleCanvasKeyDown, listenerOptions)
            this.canvas.addEventListener('wheel', this.handleWheel, {
                signal: controller.signal,
                passive: false,
            })
            document.addEventListener('pointerdown', this.handleDocumentPointerDown, {
                capture: true,
                signal: controller.signal,
            })
            this.reset.addEventListener('click', this.handleReset, listenerOptions)
            this.abortController = controller

            this.resizeObserver = new ResizeObserver(() => this.draw())
            this.resizeObserver.observe(this.canvas)
            this.colorScheme = window.matchMedia('(prefers-color-scheme: dark)')
            this.colorScheme.addEventListener('change', this.handleColorScheme, listenerOptions)
            this.draw()
        }

        disconnectedCallback() {
            this.resizeObserver?.disconnect()
            this.abortController?.abort()
            this.resizeObserver = undefined
            this.abortController = undefined
            this.activePointer = undefined
            this.dragStart = undefined
            this.setWheelActive(false)
        }

        private getMetrics(): PlotMetrics | undefined {
            if (!this.canvas) return undefined
            const width = this.canvas.clientWidth
            const height = this.canvas.clientHeight
            if (width <= 0 || height <= 0) return undefined

            const left = width < 420 ? 39 : 46
            const right = 14
            const top = 14
            const bottom = 30
            return {
                width,
                height,
                left,
                right,
                top,
                bottom,
                plotWidth: width - left - right,
                plotHeight: height - top - bottom,
            }
        }

        private getPosition(event: PointerEvent | WheelEvent, metrics: PlotMetrics) {
            if (!this.canvas) return {x: 0, y: 0}
            const bounds = this.canvas.getBoundingClientRect()
            return {
                x: Math.min(metrics.width, Math.max(0, event.clientX - bounds.left)),
                y: Math.min(metrics.height, Math.max(0, event.clientY - bounds.top)),
            }
        }

        private screenToGraph(position: {x: number; y: number}, metrics: PlotMetrics) {
            if (!this.view) return {x: 0, y: 0}
            return {
                x:
                    this.view.xMin +
                    ((position.x - metrics.left) / metrics.plotWidth) *
                        (this.view.xMax - this.view.xMin),
                y:
                    this.view.yMax -
                    ((position.y - metrics.top) / metrics.plotHeight) *
                        (this.view.yMax - this.view.yMin),
            }
        }

        private handlePointerDown = (event: PointerEvent) => {
            if (!this.canvas || !this.view || event.button !== 0) return
            this.canvas.focus({preventScroll: true})
            this.setWheelActive(true)
            this.activePointer = event.pointerId
            this.dragStart = {
                clientX: event.clientX,
                clientY: event.clientY,
                view: {...this.view},
            }
            this.canvas.setPointerCapture(event.pointerId)
            this.canvas.classList.add('is-dragging')
        }

        private handlePointerMove = (event: PointerEvent) => {
            const metrics = this.getMetrics()
            if (!metrics || !this.view) return

            if (this.activePointer === event.pointerId && this.dragStart) {
                const xSpan = this.dragStart.view.xMax - this.dragStart.view.xMin
                const ySpan = this.dragStart.view.yMax - this.dragStart.view.yMin
                const xOffset =
                    ((event.clientX - this.dragStart.clientX) / metrics.plotWidth) * xSpan
                const yOffset =
                    ((event.clientY - this.dragStart.clientY) / metrics.plotHeight) * ySpan
                this.view = {
                    xMin: this.dragStart.view.xMin - xOffset,
                    xMax: this.dragStart.view.xMax - xOffset,
                    yMin: this.dragStart.view.yMin + yOffset,
                    yMax: this.dragStart.view.yMax + yOffset,
                }
                this.draw()
            }

            const graphPosition = this.screenToGraph(this.getPosition(event, metrics), metrics)
            if (this.coordinates) {
                this.coordinates.textContent = `x = ${formatTick(graphPosition.x, (this.view.xMax - this.view.xMin) / 100)} · y = ${formatTick(graphPosition.y, (this.view.yMax - this.view.yMin) / 100)}`
            }
        }

        private handlePointerUp = (event: PointerEvent) => {
            if (!this.canvas || this.activePointer !== event.pointerId) return
            if (this.canvas.hasPointerCapture(event.pointerId)) {
                this.canvas.releasePointerCapture(event.pointerId)
            }
            this.activePointer = undefined
            this.dragStart = undefined
            this.canvas.classList.remove('is-dragging')
        }

        private handlePointerLeave = () => {
            if (!this.activePointer && this.coordinates) {
                this.coordinates.textContent = 'x = — · y = —'
            }
        }

        private handleCanvasFocus = () => this.setWheelActive(true)

        private handleCanvasBlur = () => this.setWheelActive(false)

        private handleCanvasKeyDown = (event: KeyboardEvent) => {
            if (event.key !== 'Escape' || !this.canvas) return
            this.canvas.blur()
        }

        private handleDocumentPointerDown = (event: PointerEvent) => {
            if (event.target instanceof Node && !this.contains(event.target)) {
                this.setWheelActive(false)
            }
        }

        private setWheelActive(active: boolean) {
            if (this.wheelActive === active) return
            this.wheelActive = active
            this.dataset.wheelActive = String(active)
            if (this.hint) {
                this.hint.textContent = active
                    ? '滚轮缩放已启用 · 点击外部退出'
                    : '点击图像后可用滚轮缩放'
            }
        }

        private handleWheel = (event: WheelEvent) => {
            if (!this.wheelActive) return
            const metrics = this.getMetrics()
            if (!metrics || !this.view) return
            event.preventDefault()

            const graphPosition = this.screenToGraph(this.getPosition(event, metrics), metrics)
            const oldXSpan = this.view.xMax - this.view.xMin
            const oldYSpan = this.view.yMax - this.view.yMin
            const factor = Math.exp(Math.max(-1, Math.min(1, event.deltaY * 0.002)))
            const newXSpan = clampSpan(oldXSpan * factor)
            const newYSpan = clampSpan(oldYSpan * factor)
            const xRatio = (graphPosition.x - this.view.xMin) / oldXSpan
            const yRatio = (graphPosition.y - this.view.yMin) / oldYSpan

            this.view = {
                xMin: graphPosition.x - newXSpan * xRatio,
                xMax: graphPosition.x + newXSpan * (1 - xRatio),
                yMin: graphPosition.y - newYSpan * yRatio,
                yMax: graphPosition.y + newYSpan * (1 - yRatio),
            }
            this.draw()
        }

        private handleReset = () => {
            if (!this.initialView) return
            this.view = {...this.initialView}
            if (this.coordinates) this.coordinates.textContent = 'x = — · y = —'
            this.draw()
        }

        private handleColorScheme = () => this.draw()

        private showError(error: unknown) {
            if (!this.error || !this.canvas) return
            this.error.textContent = error instanceof Error ? error.message : '函数图像无法绘制'
            this.error.hidden = false
            this.canvas.hidden = true
            if (this.coordinates) this.coordinates.hidden = true
        }

        private draw() {
            if (!this.canvas || !this.context || !this.view) return
            const metrics = this.getMetrics()
            if (!metrics) return

            const ratio = Math.min(2, window.devicePixelRatio || 1)
            const pixelWidth = Math.round(metrics.width * ratio)
            const pixelHeight = Math.round(metrics.height * ratio)
            if (this.canvas.width !== pixelWidth || this.canvas.height !== pixelHeight) {
                this.canvas.width = pixelWidth
                this.canvas.height = pixelHeight
            }

            const context = this.context
            context.setTransform(ratio, 0, 0, ratio, 0, 0)
            context.clearRect(0, 0, metrics.width, metrics.height)

            const styles = getComputedStyle(this)
            const color = (name: string, fallback: string) =>
                styles.getPropertyValue(name).trim() || fallback
            const background = color('--theme-code-bg', '#fff')
            const foreground = color('--theme-fg', '#383a42')
            const muted = color('--theme-muted', '#696c77')
            const border = color('--theme-border', '#dbdbdc')
            const grid = color('--function-plot-grid', border)
            const axis = color('--function-plot-axis', muted)

            context.fillStyle = background
            context.fillRect(0, 0, metrics.width, metrics.height)
            context.font = '11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace'
            context.textBaseline = 'middle'

            const xSpan = this.view.xMax - this.view.xMin
            const ySpan = this.view.yMax - this.view.yMin
            const xStep = niceStep(xSpan)
            const yStep = niceStep(ySpan)
            const graphToScreenX = (x: number) =>
                metrics.left + ((x - this.view!.xMin) / xSpan) * metrics.plotWidth
            const graphToScreenY = (y: number) =>
                metrics.top + ((this.view!.yMax - y) / ySpan) * metrics.plotHeight

            context.save()
            context.beginPath()
            context.rect(metrics.left, metrics.top, metrics.plotWidth, metrics.plotHeight)
            context.clip()
            context.strokeStyle = grid
            context.lineWidth = 1
            context.setLineDash([])

            const firstX = Math.ceil(this.view.xMin / xStep) * xStep
            for (let x = firstX; x <= this.view.xMax + xStep * 0.5; x += xStep) {
                const screenX = graphToScreenX(x)
                context.beginPath()
                context.moveTo(screenX, metrics.top)
                context.lineTo(screenX, metrics.height - metrics.bottom)
                context.stroke()
            }

            const firstY = Math.ceil(this.view.yMin / yStep) * yStep
            for (let y = firstY; y <= this.view.yMax + yStep * 0.5; y += yStep) {
                const screenY = graphToScreenY(y)
                context.beginPath()
                context.moveTo(metrics.left, screenY)
                context.lineTo(metrics.width - metrics.right, screenY)
                context.stroke()
            }

            context.strokeStyle = axis
            context.lineWidth = 1.5
            if (this.view.xMin <= 0 && this.view.xMax >= 0) {
                const screenX = graphToScreenX(0)
                context.beginPath()
                context.moveTo(screenX, metrics.top)
                context.lineTo(screenX, metrics.height - metrics.bottom)
                context.stroke()
            }
            if (this.view.yMin <= 0 && this.view.yMax >= 0) {
                const screenY = graphToScreenY(0)
                context.beginPath()
                context.moveTo(metrics.left, screenY)
                context.lineTo(metrics.width - metrics.right, screenY)
                context.stroke()
            }

            this.series.forEach((item, index) => {
                context.strokeStyle = color(`--function-plot-series-${index + 1}`, foreground)
                context.lineWidth = 2
                context.lineJoin = 'round'
                context.lineCap = 'round'
                context.setLineDash(lineDashes[index] ?? [])
                context.beginPath()

                let drawing = false
                let previousY: number | undefined
                const samples = Math.max(240, Math.round(metrics.plotWidth * 1.5))
                for (let sample = 0; sample <= samples; sample += 1) {
                    const screenX = metrics.left + (sample / samples) * metrics.plotWidth
                    const x = this.view!.xMin + (sample / samples) * xSpan
                    const y = item.evaluate(x)
                    const screenY = graphToScreenY(y)
                    const discontinuous =
                        !Number.isFinite(y) ||
                        !Number.isFinite(screenY) ||
                        screenY < metrics.top - metrics.plotHeight * 4 ||
                        screenY > metrics.height - metrics.bottom + metrics.plotHeight * 4 ||
                        (previousY !== undefined &&
                            Math.abs(screenY - previousY) > metrics.plotHeight * 1.5)

                    if (discontinuous) {
                        drawing = false
                        previousY = undefined
                        continue
                    }
                    if (!drawing) {
                        context.moveTo(screenX, screenY)
                        drawing = true
                    } else {
                        context.lineTo(screenX, screenY)
                    }
                    previousY = screenY
                }
                context.stroke()
            })
            context.restore()

            context.setLineDash([])
            context.fillStyle = muted
            context.textAlign = 'center'
            for (let x = firstX; x <= this.view.xMax + xStep * 0.5; x += xStep) {
                context.fillText(
                    formatTick(x, xStep),
                    graphToScreenX(x),
                    metrics.height - metrics.bottom / 2,
                )
            }

            context.textAlign = 'right'
            for (let y = firstY; y <= this.view.yMax + yStep * 0.5; y += yStep) {
                if (Math.abs(y) < yStep * 0.001) continue
                context.fillText(formatTick(y, yStep), metrics.left - 7, graphToScreenY(y))
            }

            context.strokeStyle = border
            context.lineWidth = 1
            context.strokeRect(metrics.left, metrics.top, metrics.plotWidth, metrics.plotHeight)
        }
    }

    if (!customElements.get('mdx-function-plot')) {
        customElements.define('mdx-function-plot', MdxFunctionPlot)
    }
</script>

<style>
    mdx-function-plot {
        display: block;
    }
</style>
