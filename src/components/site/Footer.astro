---
import {getCollection} from 'astro:content'

const [markdownPosts, typstPosts] = await Promise.all([
    getCollection('posts'),
    getCollection('typstPosts'),
])
const draftCount = [...markdownPosts, ...typstPosts].filter(({data}) => data.draft).length
---

<div class="flex items-center justify-start">
    <div class="text-sm">
        寒冰还有 <span class="text-(--theme-fg)">{draftCount}</span> 篇 draft 中的文章，谴责它摸鱼！
    </div>
</div>
