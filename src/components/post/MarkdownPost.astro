---
import {render, type CollectionEntry} from 'astro:content'
import PostLayout from '../../layouts/PostLayout.astro'
import PostSidebar from './PostSidebar.astro'
import TableOfContents from './TableOfContents.astro'
import HandDrawnHighlightLink from '../site/HandDrawnHighlightLink.astro'
import {mdxComponents} from '../mdx'
import {convertDateFormat, toDateTime} from '../../utils/date'
import '../../styles/markdown/github.css'

interface Props {
    entry: CollectionEntry<'posts'>
}

const {entry} = Astro.props as Props
const {Content, headings, remarkPluginFrontmatter} = await render(entry)
const tags = [...entry.data['tags']]
const chatBoxHeadingIndexes = new Set<number>(
    remarkPluginFrontmatter['chatBoxHeadingIndexes'] ?? [],
)
const articleHeadings = headings.filter((_, index) => !chatBoxHeadingIndexes.has(index))
const showCreated =
    entry.data.draft ||
    !entry.data.published ||
    entry.data.created.getTime() !== entry.data.published.getTime()
---

<PostLayout
    title={entry.data['title']}
    background={entry.data['background']}
    backgroundOpacity={entry.data['backgroundOpacity']}
>
    <Fragment slot="head">
        {
            entry.data.published && (
                <meta
                    property="article:published_time"
                    content={toDateTime(entry.data.published)}
                />
            )
        }
    </Fragment>
    <PostSidebar slot="left" headings={articleHeadings} />
    {
        entry.data['draft'] && (
            <aside
                class="post-draft-notice flex items-start gap-2 rounded-lg border border-(--theme-accent) bg-(--theme-accent-soft) px-4 py-3 text-(--theme-fg)"
                aria-label="草稿状态"
            >
                <span class="post-draft-notice-icon" aria-hidden="true">
                    <span class="post-draft-notice-icon-board" />
                </span>
                <span>这篇文章还在施工中，内容可能随时变化</span>
            </aside>
        )
    }
    <h1 class="text-2xl font-bold">{entry.data['title']}</h1>
    <div class="flex flex-row flex-wrap gap-x-3 gap-y-1 text-sm text-(--theme-muted)">
        {
            showCreated && (
                <span>
                    创建于{' '}
                    <time datetime={toDateTime(entry.data.created)}>
                        {convertDateFormat(entry.data.created)}
                    </time>
                </span>
            )
        }
        {
            entry.data.published && (
                <span>
                    {entry.data.draft ? '计划发布于 ' : '发布于 '}
                    <time datetime={toDateTime(entry.data.published)}>
                        {convertDateFormat(entry.data.published)}
                    </time>
                </span>
            )
        }
    </div>
    <div class="flex flex-row flex-wrap items-center gap-2">
        {
            tags.map((tag) => (
                <HandDrawnHighlightLink href={`/tags/${encodeURIComponent(tag)}/`}>
                    {`#${tag}`}
                </HandDrawnHighlightLink>
            ))
        }
    </div>
    <div class="post-toc-mobile flex flex-col items-start gap-3" aria-label="文章导航">
        <HandDrawnHighlightLink class="self-start text-left" href="/">
            返回主页
        </HandDrawnHighlightLink>
        <TableOfContents headings={articleHeadings} />
    </div>
    <div class="markdown-body">
        <Content components={mdxComponents} />
    </div>
</PostLayout>
