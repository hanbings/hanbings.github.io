---
import SiteLayout from './SiteLayout.astro'

const {
    title,
    background,
    backgroundOpacity,
    variant = 'markdown',
} = Astro.props as {
    title: string
    background?: string
    backgroundOpacity?: number
    variant?: 'markdown' | 'paper'
}
---

<SiteLayout
    title={title}
    background={background}
    backgroundOpacity={backgroundOpacity}
    postRender
    hideFooter={variant === 'paper'}
>
    <slot name="head" slot="head" />
    <slot name="backfill-background" slot="backfill-background" />
    <slot name="header-background" slot="header-background" />
    <slot name="site-overlay" slot="site-overlay" />
    <main
        class:list={['markdown-render', variant === 'paper' && 'paper-post-render']}
        data-site-region="main"
        aria-label={title}
    >
        <article
            class:list={[
                'markdown-render-main w-full max-w-180 flex flex-col gap-4',
                variant === 'paper' && 'paper-render-main',
            ]}
            data-site-region="article"
        >
            <slot />
        </article>
        <div class="markdown-render-region markdown-render-left" data-site-region="left">
            <slot name="left" />
        </div>
        <div class="markdown-render-region markdown-render-right" data-site-region="right">
            <slot name="right" />
        </div>
    </main>
</SiteLayout>
